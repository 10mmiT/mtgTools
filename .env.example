ADMIN_PASSWORD=changeme

# Add the Secure flag to session cookies — set to 1 when served over HTTPS
# COOKIE_SECURE=1

# Behind a reverse proxy, how far to trust X-Forwarded-For: a hop count (1),
# true, or names/subnets (loopback, 10.0.0.0/8). Leave unset when the app is
# reached directly, or a client can choose the address the rate limits see.
# TRUST_PROXY=1

# Comma-separated RSS/Atom feed URLs for the right-side panel (optional)
# RSS_FEEDS=https://www.mtggoldfish.com/news/rss,https://magic.wizards.com/rss.xml
