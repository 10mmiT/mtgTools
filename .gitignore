# Dependencies
node_modules/

# Databases and their write-ahead logs. The app's own data/ is created at
# runtime; data.bak/ is whatever was moved aside before a restore.
data/
data.bak/
*.db
*.db-shm
*.db-wal

# Secrets — .env.example is the committed one
.env

# Screenshots. capture-screens.js writes PNGs and nothing else here is one;
# the app's own artwork is SVG and its fonts are woff2.
*.png

# Scratch. Working notes, ticket sets, screenshot runs and the populated
# database snapshot the harness renders against — all review aids, kept
# locally. What a finished piece of work is worth keeping is written up in
# docs/records/ instead.
.scratch/

# Agent tooling. The skill configuration under docs/agents/ is a local aid, not
# part of what the app is. CLAUDE.md is committed: it is the orientation an AI
# model reads first, and it states what it needs from docs/agents/ itself.
.claude/
.agents/
skills-lock.json
docs/agents/

# Run output
*.log
